--Part 1 Task 1.2
WITH YearlySummaries AS (
    SELECT 
        -- Handles extraction by pulling the characters after the second slash or substring patterns
        CASE 
            WHEN date_time LIKE '%/%/%' THEN SUBSTR(SUBSTR(date_time, INSTR(date_time, '/') + 1), INSTR(SUBSTR(date_time, INSTR(date_time, '/') + 1), '/') + 1, 4)
            ELSE STRFTIME('%Y', date_time)
        END AS traffic_year,
        SUM(traffic_volume) AS total_volume
    FROM Metro_Interstate_Traffic_Volume
    GROUP BY traffic_year
)
SELECT 
    curr.traffic_year,
    curr.total_volume AS total_traffic_volume,
    (curr.total_volume - prev.total_volume) AS absolute_change,
    ROUND(((curr.total_volume - prev.total_volume) * 100.0 / prev.total_volume), 2) AS percent_change
FROM YearlySummaries curr
LEFT JOIN YearlySummaries prev 
  ON CAST(curr.traffic_year AS INTEGER) = CAST(prev.traffic_year AS INTEGER) + 1
WHERE curr.traffic_year BETWEEN '2012' AND '2017'
ORDER BY curr.traffic_year;


----Part 1 Task 1.3 - New Years Day

SELECT 
    CASE 
        WHEN date_time LIKE '%/%/%' THEN SUBSTR(SUBSTR(date_time, INSTR(date_time, '/') + 1), INSTR(SUBSTR(date_time, INSTR(date_time, '/') + 1), '/') + 1, 4)
        ELSE STRFTIME('%Y', date_time)
    END AS holiday_year,
    holiday AS holiday_name,
    ROUND(AVG(temp), 2) AS average_temp_kelvin,
    ROUND(AVG(temp) - 273.15, 2) AS average_temp_celsius,
    SUM(traffic_volume) AS cumulative_holiday_traffic,
    ROUND(AVG(traffic_volume), 2) AS average_hourly_traffic
FROM Metro_Interstate_Traffic_Volume
WHERE holiday IN (&quot;New Years Day&quot;)
  AND holiday_year IN ('2015', '2016', '2017')
GROUP BY holiday_year, holiday_name
ORDER BY holiday_name, holiday_year;


----Part 1 Task 1.3 - Labor Day

SELECT 
    CASE 
        WHEN date_time LIKE '%/%/%' THEN SUBSTR(SUBSTR(date_time, INSTR(date_time, '/') + 1), INSTR(SUBSTR(date_time, INSTR(date_time, '/') + 1), '/') + 1, 4)
        ELSE STRFTIME('%Y', date_time)
    END AS holiday_year,
    holiday AS holiday_name,
    ROUND(AVG(temp), 2) AS average_temp_kelvin,
    ROUND(AVG(temp) - 273.15, 2) AS average_temp_celsius,
    SUM(traffic_volume) AS cumulative_holiday_traffic,
    ROUND(AVG(traffic_volume), 2) AS average_hourly_traffic
FROM Metro_Interstate_Traffic_Volume
WHERE holiday IN (&quot;Labor Day&quot;)
  AND holiday_year IN ('2015', '2016', '2017')
GROUP BY holiday_year, holiday_name
ORDER BY holiday_name, holiday_year;

----Part 1 Task 1.3 - New Year Day, Labor Day

SELECT 
    CASE 
        WHEN date_time LIKE '%/%/%' THEN SUBSTR(SUBSTR(date_time, INSTR(date_time, '/') + 1), INSTR(SUBSTR(date_time, INSTR(date_time, '/') + 1), '/') + 1, 4)
        ELSE STRFTIME('%Y', date_time)
    END AS holiday_year,
    holiday AS holiday_name,
    ROUND(AVG(temp), 2) AS average_temp_kelvin,
    ROUND(AVG(temp) - 273.15, 2) AS average_temp_celsius,
    SUM(traffic_volume) AS cumulative_holiday_traffic,
    ROUND(AVG(traffic_volume), 2) AS average_hourly_traffic
FROM Metro_Interstate_Traffic_Volume
WHERE holiday IN (&quot;New Years Day&quot;, &quot;Labor Day&quot;)
  AND holiday_year IN ('2015', '2016', '2017')
GROUP BY holiday_year, holiday_name
ORDER BY holiday_name, holiday_year;</sql><current_tab id="0"/></tab_sql></sqlb_project>
